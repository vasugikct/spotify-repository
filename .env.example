# Environment variables for Spotify Tamil AI App
# Copy this file to .env and fill in your values
# API keys are kept in environment variables — never commit .env to GitHub!

PORT=3000
NODE_ENV=production

# MongoDB Atlas connection string (for chat logs & feedback)
# Leave empty to use local fallback file storage
MONGODB_URI=

# Third-party API timeout in milliseconds
THIRD_PARTY_TIMEOUT_MS=2500

